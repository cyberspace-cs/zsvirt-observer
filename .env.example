# ====================
# ZSvirt 配置
# ====================
ZSVIRT_BASE_URL=http://localhost:5050
ZSVIRT_USERNAME=admin
ZSVIRT_PASSWORD=your-password-here

# ====================
# 应用配置
# ====================
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ====================
# Prometheus 配置
# ====================
PROMETHEUS_URL=http://prometheus:9090

# ====================
# 告警配置
# ====================
ALERT_WINDOW_SECONDS=300
ALERT_GROUP_THRESHOLD=3

# ====================
# LLM 配置（智能根因分析）
# ====================
# 选择提供商: deepseek / qwen / ark / openrouter
LLM_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼 (Qwen)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 火山方舟 (Ark)
ARK_API_KEY=
ARK_MODEL=doubao-pro-4k

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# ====================
# OpenTelemetry
# ====================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=zsvirt-observer
