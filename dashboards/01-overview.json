{
  "dashboard": {
    "id": null,
    "uid": "zsvirt-overview",
    "title": "ZSvirt 全栈概览",
    "tags": ["zsvirt", "overview"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "宿主机数量",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [{"expr": "count(up{job=\"node\"})", "refId": "A"}]
      },
      {
        "id": 2,
        "type": "stat",
        "title": "容器数量",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [{"expr": "count(container_last_seen)", "refId": "A"}]
      },
      {
        "id": 3,
        "type": "stat",
        "title": "GPU 利用率",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [{"expr": "avg(DCGM_FI_DEV_GPU_UTIL)", "refId": "A"}]
      },
      {
        "id": 4,
        "type": "stat",
        "title": "活跃告警",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [{"expr": "count(ALERTS{state=\"firing\"})", "refId": "A"}]
      },
      {
        "id": 5,
        "type": "timeseries",
        "title": "CPU 使用率",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [{"expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A"}]
      },
      {
        "id": 6,
        "type": "timeseries",
        "title": "内存使用率",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [{"expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "refId": "A"}]
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "10s"
  },
  "meta": {
    "isFeatured": false,
    "folderTitle": "ZSvirt"
  }
}
